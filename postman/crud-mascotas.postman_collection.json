{
  "info": {
    "_postman_id": "f3a1c2d4-0000-4000-8000-000000000003",
    "name": "CRUD Mascotas - Lab3 Serverless",
    "description": "Colección para probar la API serverless de mascotas (Lambda + API Gateway + DynamoDB). Configura la variable baseUrl con la URL del despliegue.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "mascotaId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Crear mascota (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "if (body && body.id) { pm.collectionVariables.set('mascotaId', body.id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Firulais\",\n  \"especie\": \"perro\",\n  \"raza\": \"Labrador\",\n  \"edadMeses\": 24,\n  \"pesoKg\": 28.5,\n  \"vacunada\": true\n}"
        },
        "url": { "raw": "{{baseUrl}}/mascotas", "host": ["{{baseUrl}}"], "path": ["mascotas"] }
      }
    },
    {
      "name": "Crear mascota inválida (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('400 Bad Request', function () { pm.response.to.have.status(400); });"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{ \"nombre\": \"\" }" },
        "url": { "raw": "{{baseUrl}}/mascotas", "host": ["{{baseUrl}}"], "path": ["mascotas"] }
      }
    },
    {
      "name": "Listar mascotas (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('200 OK', function () { pm.response.to.have.status(200); });"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/mascotas", "host": ["{{baseUrl}}"], "path": ["mascotas"] }
      }
    },
    {
      "name": "Obtener mascota (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('200 OK', function () { pm.response.to.have.status(200); });"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/mascotas/{{mascotaId}}",
          "host": ["{{baseUrl}}"],
          "path": ["mascotas", "{{mascotaId}}"]
        }
      }
    },
    {
      "name": "Obtener mascota inexistente (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('404 Not Found', function () { pm.response.to.have.status(404); });"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/mascotas/no-existe",
          "host": ["{{baseUrl}}"],
          "path": ["mascotas", "no-existe"]
        }
      }
    },
    {
      "name": "Actualizar mascota (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('200 OK', function () { pm.response.to.have.status(200); });"]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Firulais\",\n  \"especie\": \"perro\",\n  \"raza\": \"Labrador\",\n  \"edadMeses\": 25,\n  \"pesoKg\": 29,\n  \"vacunada\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/mascotas/{{mascotaId}}",
          "host": ["{{baseUrl}}"],
          "path": ["mascotas", "{{mascotaId}}"]
        }
      }
    },
    {
      "name": "Actualizar mascota inexistente (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('404 Not Found', function () { pm.response.to.have.status(404); });"]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Nadie\",\n  \"especie\": \"perro\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/mascotas/no-existe",
          "host": ["{{baseUrl}}"],
          "path": ["mascotas", "no-existe"]
        }
      }
    },
    {
      "name": "Eliminar mascota (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('200 OK', function () { pm.response.to.have.status(200); });"]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/mascotas/{{mascotaId}}",
          "host": ["{{baseUrl}}"],
          "path": ["mascotas", "{{mascotaId}}"]
        }
      }
    },
    {
      "name": "Eliminar mascota inexistente (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('404 Not Found', function () { pm.response.to.have.status(404); });"]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/mascotas/no-existe",
          "host": ["{{baseUrl}}"],
          "path": ["mascotas", "no-existe"]
        }
      }
    }
  ]
}
